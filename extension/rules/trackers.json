{
  "version": "0.1.0",
  "notes": "Third-party domains grouped by what they do to you. Matched against script/iframe/image/resource hosts by registrable-domain suffix. Categories feed the 'surveillance' and 'social_proof' findings. Add freely.",
  "categoryInfo": {
    "advertising": {
      "name": "Ad-tech / programmatic advertising",
      "severity": 1,
      "explain": "Ad exchanges and demand platforms that profile you across sites. On a page with ad slots they auction your attention in real time; on a page without them they follow visitors to other sites."
    },
    "analytics": {
      "name": "Analytics",
      "severity": 1,
      "explain": "Measures what you do on the page. Low severity alone; combined with ad-tech it fuels profiling."
    },
    "session_replay": {
      "name": "Session replay / heatmaps",
      "severity": 3,
      "explain": "Records your mouse movements, scrolling, clicks and often keystrokes to replay later as video. Can capture text you typed and deleted."
    },
    "social_pixel": {
      "name": "Social-media pixels",
      "severity": 2,
      "explain": "Tells Meta, TikTok, Snap, Pinterest, LinkedIn or X that you visited this page and what you did, tied to your social identity."
    },
    "fingerprinting": {
      "name": "Device fingerprinting",
      "severity": 2,
      "explain": "Identifies your device by its unique properties so you can be tracked even without cookies."
    },
    "marketing_automation": {
      "name": "Marketing automation / CRM",
      "severity": 1,
      "explain": "Links your browsing to your email identity to trigger drip campaigns and retargeting."
    },
    "social_proof_widget": {
      "name": "Social-proof pop-up vendor",
      "severity": 3,
      "explain": "A service whose product is 'someone in Ohio just bought this' notifications. Its presence means the activity toasts on this page are generated, not observed."
    },
    "urgency_widget": {
      "name": "Countdown / urgency widget vendor",
      "severity": 3,
      "explain": "A service that sells evergreen countdown timers and deadline funnels. Timers from these vendors restart for each visitor."
    },
    "popup_capture": {
      "name": "Pop-up / email-capture vendor",
      "severity": 2,
      "explain": "Exit-intent and scroll-triggered pop-ups designed to interrupt you and harvest contact details."
    },
    "push_notifications": {
      "name": "Push-notification vendor",
      "severity": 2,
      "explain": "Infrastructure for re-engaging you with browser notifications after you leave."
    },
    "ab_testing": {
      "name": "A/B testing / personalization",
      "severity": 1,
      "explain": "The page you see may differ from what others see; copy, prices and layouts are being optimized against you in real time."
    },
    "chat_widget": {
      "name": "Live-chat widget",
      "severity": 1,
      "explain": "Proactive chat bubbles ('Hi there 👋') are interruption marketing and usually feed a CRM."
    },
    "bnpl": {
      "name": "Buy-now-pay-later provider",
      "severity": 2,
      "explain": "Installment payment widgets that reduce the pain of paying and raise average order values."
    },
    "consent_manager": {
      "name": "Consent management platform",
      "severity": 0,
      "explain": "Shows the cookie banner. Neutral in itself; check whether 'reject' is as easy as 'accept'."
    },
    "affiliate": {
      "name": "Affiliate network",
      "severity": 2,
      "explain": "Links on this page earn the publisher a commission when you buy. Recommendations are compensated."
    },
    "native_ads": {
      "name": "Native / 'around the web' ad network",
      "severity": 2,
      "explain": "Chumbox widgets that disguise ads as recommended articles, frequently for low-quality or deceptive products."
    },
    "data_broker": {
      "name": "Data broker / identity graph",
      "severity": 3,
      "explain": "Companies whose business is buying, matching and reselling profiles of people. Their presence means your visit can be joined to a purchasable identity graph (email, address, purchase history, inferred traits)."
    },
    "ad_measurement": {
      "name": "Ad verification / audience measurement",
      "severity": 0,
      "explain": "Vendors that check where ads appeared and count audiences for advertisers. They see your visit but do not bid for it."
    },
    "identity": {
      "name": "Cross-site ID service",
      "severity": 2,
      "explain": "Services that build a shared ID for you so ad vendors can recognise you across sites without third-party cookies."
    },
    "bot_defence": {
      "name": "Bot defence",
      "severity": 0,
      "explain": "Your device is fingerprinted to tell humans from bots. The mechanism is real; the purpose is blocking automated traffic rather than advertising."
    },
    "fraud_check": {
      "name": "Payment fraud check",
      "severity": 0,
      "explain": "Your device is fingerprinted to score the risk of fraud on a payment or an account. The mechanism is real; the purpose is fraud prevention rather than advertising."
    },
    "reviews_widget": {
      "name": "Reviews widget",
      "severity": 0,
      "explain": "A review platform shows customer reviews on this page. Check whether the seller can filter what is shown."
    },
    "funnel_builder": {
      "name": "Funnel builder",
      "severity": 0,
      "explain": "A landing-page or sales-funnel builder made this page. Its presence alone proves nothing about the timers or claims on it."
    }
  },
